{
  "manifest_version": 3,
  "name": "SF Nav Palette",
  "version": "0.1.0",
  "description": "Command palette for Salesforce admins — jump to any object, field, Apex class, flow, or Setup page.",

  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },

  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "Open SF Nav Palette (Ctrl+Shift+K)"
  },

  "permissions": ["cookies", "storage", "tabs"],

  "host_permissions": [
    "https://*.lightning.force.com/*",
    "https://*.my.salesforce-setup.com/*",
    "https://*.my.salesforce.com/*"
  ],

  "background": {
    "service_worker": "background.js",
    "type": "module"
  },

  "content_scripts": [
    {
      "matches": [
        "https://*.lightning.force.com/*",
        "https://*.my.salesforce-setup.com/*",
        "https://*.my.salesforce.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": false
    },
    {
      "matches": [
        "https://*.lightning.force.com/*",
        "https://*.my.salesforce-setup.com/*",
        "https://*.my.salesforce.com/*"
      ],
      "js": ["keys.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ],

  "web_accessible_resources": [
    {
      "resources": ["src/*.js", "src/*.css", "src/providers/*.js"],
      "matches": [
        "https://*.lightning.force.com/*",
        "https://*.my.salesforce-setup.com/*",
        "https://*.my.salesforce.com/*"
      ]
    }
  ],

  "commands": {
    "open-palette": {
      "suggested_key": {
        "default": "Ctrl+Shift+K",
        "mac": "Command+Shift+K"
      },
      "description": "Open the Salesforce nav palette"
    }
  }
}
